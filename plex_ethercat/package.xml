<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plex_ethercat</name>
  <version>0.1.0</version>
  <description>SPEAR EtherCAT hardware configuration for the PLEX arm.</description>
  <maintainer email="nathanc54@shaw.ca">nathan</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ethercat_driver</exec_depend>
  <exec_depend>ethercat_generic_cia402_drive</exec_depend>
  <exec_depend>ethercat_generic_slave</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

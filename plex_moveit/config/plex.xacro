<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="plex">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import plex urdf file -->
    <xacro:include filename="$(find plex_moveit)/urdf/plex.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="plex.ros2_control.xacro" />


    <xacro:plex_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
